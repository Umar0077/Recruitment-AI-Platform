# InterviewOS backend — copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL (local: interviewos-infrastructure/database/local). Use the app role, not the superuser.
DATABASE_URL=postgresql://interviewos_app:CHANGE_ME@127.0.0.1:5432/interviewos?schema=public&connection_limit=10
# Isolated database for automated tests (wiped by the e2e suite).
TEST_DATABASE_URL=postgresql://interviewos_app:CHANGE_ME@127.0.0.1:5432/interviewos_test?schema=public&connection_limit=5

# Comma-separated exact browser origins. Never "*".
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Auth: firebase (required in production) or test (dev/automated tests only; refused in production).
AUTH_MODE=firebase
AUTH_ALLOWED_PROVIDERS=google.com,password
FIREBASE_PROJECT_ID=
# Preferred: local file or a read-only mounted secret. Relative to interviewos-backend/.
GOOGLE_APPLICATION_CREDENTIALS=
# Legacy alternative only: leave both empty when using the credential file.
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key with literal \n line breaks. Keep it out of Git.
FIREBASE_PRIVATE_KEY=
# Development with the Auth Emulator (see docs/firebase-setup.md): AUTH_MODE=firebase,
# FIREBASE_PROJECT_ID=demo-interviewos, FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 (refused in production)
# Clear GOOGLE_APPLICATION_CREDENTIALS and both inline fields when using the emulator.
FIREBASE_AUTH_EMULATOR_HOST=
AUTO_LINK_CANDIDATE_BY_VERIFIED_EMAIL=true
RECRUITER_SCOPE=all

# Background jobs. Without Redis, keep JOBS_IN_PROCESS=true.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JOBS_IN_PROCESS=true

SWAGGER_ENABLED=true
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
APP_TIMEZONE=Asia/Karachi

INTERVIEW_COMPLETION_WINDOW_HOURS=48
INTERVIEW_REMINDER_AFTER_HOURS=24

# Shared secret for the Careers Website → InterviewOS intake (min 32 chars). Empty = integration disabled.
CAREERS_INTEGRATION_KEY=
MEDIA_STORAGE_ENABLED=false

# Seed: create test-mode dev users + sample candidates (ignored in production).
SEED_DEV_DATA=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=InterviewOS
AI_ASSESSMENT_ENABLED=true
AI_ASSESSMENT_MODE=synthetic_test_only
AI_APPROVED_MODEL=
AI_PROVIDER_APPROVAL_REFERENCE=
AI_MAX_REQUESTS_PER_DAY=40
AI_MAX_REQUESTS_PER_MINUTE=15
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_CONCURRENT_REQUESTS=1
AI_REQUIRE_HR_APPROVED_RUBRIC=true
# Consented interview recording. Keep disabled until organization policy and private storage are approved.
RECORDING_MODE=approved
RECORDING_ENABLED=false
RECORDING_UPLOAD_ENABLED=false
RECORDING_MONITORING_ENABLED=false
RECORDING_CAMERA_ENABLED=true
RECORDING_SCREEN_REQUIREMENT=selected_surface
# 0 disables availability; set an approved number of days (1..3650), never an indefinite default.
RECORDING_RETENTION_DAYS=0
RECORDING_POLICY_REFERENCE=
RECORDING_SUPPORT_EMAIL=
RECORDING_MAX_MB=256
RECORDING_WIDTH=1280
RECORDING_HEIGHT=720
RECORDING_FPS=20
RECORDING_VIDEO_BITRATE=1800000
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=us-east-1
RECORDING_S3_BUCKET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_PATH_STYLE=true
# bucket = inspect S3 bucket CORS. probe is restricted to the isolated fictional lab.
RECORDING_S3_CORS_MODE=bucket
