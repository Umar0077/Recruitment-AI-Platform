{
  "name": "interviewos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "InterviewOS backend — NestJS REST API, PostgreSQL (Prisma), Firebase auth, BullMQ workers.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "ai:prepare-rubrics": "tsx prisma/prepare-rubrics.ts",
    "ai:smoke": "tsx prisma/smoke-openrouter.ts",
    "ai:metadata": "tsx prisma/check-openrouter-metadata.ts",
    "test:usage": "jest --config jest.usage.config.js --runInBand",
    "test:usage:db": "tsx test/usage-db/usage.integration.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:auth": "jest --config jest.auth.config.js --runInBand",
    "test:auth:db": "tsx test/auth-db/profile.integration.ts",
    "auth:check:live": "node --env-file=.env --import tsx prisma/check-firebase.ts",
    "test:e2e": "jest --runInBand test/e2e",
    "admin:grant": "tsx prisma/grant-role.ts",
    "db:inspect": "tsx prisma/inspect-interview.ts",
    "admin:bootstrap": "tsx prisma/admin-access.ts",
    "admin:recover": "tsx prisma/admin-access.ts --recover",
    "test:admin:db": "tsx test/auth-db/admin.integration.ts",
    "speech:evaluate:fictional": "tsx prisma/evaluate-transcript-cleanup.ts",
    "test:recordings": "jest --config jest.recordings.config.js --runInBand",
    "test:recordings:db": "tsx test/recordings-db/persistence.integration.ts",
    "recording:lab:init": "tsx prisma/recording-lab.ts init",
    "recording:lab:setup": "tsx prisma/recording-lab.ts setup",
    "recording:lab:backend": "tsx prisma/recording-lab.ts backend",
    "recording:lab:frontend": "tsx prisma/recording-lab.ts frontend",
    "test:recordings:live": "node test/recordings-db/lab-http.integration.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.0.7",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.45.2",
    "bullmq": "^5.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.2.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.5.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  }
}
