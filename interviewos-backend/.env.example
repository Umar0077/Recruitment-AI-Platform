# InterviewOS backend — copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL (local: interviewos-infrastructure/database/local). Use the app role, not the superuser.
DATABASE_URL=postgresql://interviewos_app:CHANGE_ME@127.0.0.1:5432/interviewos?schema=public&connection_limit=10
# Isolated database for automated tests (wiped by the e2e suite).
TEST_DATABASE_URL=postgresql://interviewos_app:CHANGE_ME@127.0.0.1:5432/interviewos_test?schema=public&connection_limit=5

# Comma-separated exact browser origins. Never "*".
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Auth: firebase (required in production) or test (dev/automated tests only; refused in production).
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key with literal \n line breaks. Keep it out of Git.
FIREBASE_PRIVATE_KEY=
# Development with the Auth Emulator (see docs/firebase-setup.md): AUTH_MODE=firebase,
# FIREBASE_PROJECT_ID=demo-interviewos, FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 (refused in production)
AUTO_LINK_CANDIDATE_BY_VERIFIED_EMAIL=true
RECRUITER_SCOPE=all

# Background jobs. Without Redis, keep JOBS_IN_PROCESS=true.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JOBS_IN_PROCESS=true

SWAGGER_ENABLED=true
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
APP_TIMEZONE=Asia/Karachi

INTERVIEW_COMPLETION_WINDOW_HOURS=48
INTERVIEW_REMINDER_AFTER_HOURS=24

# Shared secret for the Careers Website → InterviewOS intake (min 32 chars). Empty = integration disabled.
CAREERS_INTEGRATION_KEY=
MEDIA_STORAGE_ENABLED=false

# Seed: create test-mode dev users + sample candidates (ignored in production).
SEED_DEV_DATA=true
