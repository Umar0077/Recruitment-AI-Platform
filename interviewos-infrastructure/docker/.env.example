# Server secrets for docker-compose.yml. Copy to .env (git-ignored), chmod 600, fill in strong random values:
#   openssl rand -base64 32
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=
APP_DB_USER=interviewos_app
APP_DB_PASSWORD=
APP_DB_NAME=interviewos
REDIS_PASSWORD=

# Exact HTTPS origin(s) of the frontend, comma-separated. Never "*".
FRONTEND_ORIGINS=https://interviews.example.com

# Firebase service account (Firebase console → Project settings → Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Keep false in production unless /api/docs is IP-restricted in Nginx.
SWAGGER_ENABLED=false
# Shared secret for the Careers Website intake (min 32 chars). Empty = disabled.
CAREERS_INTEGRATION_KEY=
