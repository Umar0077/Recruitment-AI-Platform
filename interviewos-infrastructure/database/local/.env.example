# Local development PostgreSQL (not for production).
PG_PORT=5432
# Superuser used only to create the database and the app role.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me-local-superuser
# Least-privilege application role used by the backend.
APP_DB_USER=interviewos_app
APP_DB_PASSWORD=change-me-local-app
# Data directory lives OUTSIDE the repo (and outside OneDrive) — never commit database files.
# Defaults to %LOCALAPPDATA%\InterviewOS\pgdata on Windows, ~/.interviewos/pgdata elsewhere.
PG_DATA_DIR=
