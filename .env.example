# Frontend environment — copy to .env.local (git-ignored).
#
#   demo : everything runs on in-browser sample data (default). No real authentication, no backend.
#   api  : Google Sign-In (Firebase) + the InterviewOS backend. Failed requests show errors,
#          they never fall back to demo data.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Firebase web app config (Firebase console → Project settings → Your apps). Public identifiers, not secrets.
# In production set AUTH_DOMAIN to the frontend's own domain — see interviewos-backend/docs/firebase-setup.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Local development against the Firebase Auth Emulator (no real Google accounts) ──
# cd interviewos-infrastructure/firebase && npm run emulator, then use:
#   NEXT_PUBLIC_APP_MODE=api
#   NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-interviewos
#   NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
#   NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099     (ignored in production builds)
