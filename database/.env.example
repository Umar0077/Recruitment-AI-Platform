# Local PostgreSQL 17 cluster configuration (copy to database/local/.env)
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me-local-superuser-password
APP_DB_USER=interviewos_app
APP_DB_PASSWORD=change-me-local-app-password
# Optional custom data directory (defaults to %LOCALAPPDATA%/InterviewOS/pgdata on Windows)
# PG_DATA_DIR=
