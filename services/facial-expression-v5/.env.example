# InterviewOS Facial Expression V5 FastAPI Engine Configuration
# Copy to .env for local development. Never commit .env or real tokens to Git.

# Network binding (loopback only for local development)
V5_HOST=127.0.0.1
V5_PORT=8765

# Required Bearer token for /api/v1/infer/frame, /api/v1/model/info, and /api/v1/metrics
# Generate a local random token in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
V5_SERVICE_TOKEN=replace-with-local-random-token

# Path to extracted V5 model directory (defaults to ../../_local_model_inputs/v5 relative to service root)
# V5_MODEL_DIR=../../_local_model_inputs/v5

# Execution device: cpu (default), auto (CUDA if available and verified, else cpu), or cuda
V5_DEVICE=cpu

# Defensive input & concurrency limits
V5_MAX_UPLOAD_BYTES=10000000
V5_MAX_DECODED_PIXELS=12000000
V5_INFERENCE_TIMEOUT_SECONDS=15.0
V5_MAX_CONCURRENT_INFERENCES=2
V5_RATE_LIMIT_PER_MINUTE=180

# Face detection & uncertainty threshold
V5_FACE_MARGIN_RATIO=0.18
V5_UNCERTAIN_THRESHOLD=0.45

# Startup & local developer tester
V5_WARMUP_ON_STARTUP=true
V5_ENABLE_TESTER=true
V5_LOG_LEVEL=INFO
