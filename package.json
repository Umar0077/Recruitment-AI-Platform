{
  "name": "interviewos-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "InterviewOS AI Recruitment Platform (BaliTech · Powered by GO Connectivo) — Root Workspace Coordinator for Frontend, Backend, and Database.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test:auth && npm --prefix backend run test:recordings && npm --prefix backend run test:usage",
    "test:e2e": "node tests/e2e/browser-performance.mjs",
    "test:performance": "node scripts/browser-performance.mjs",
    "db:start": "npm --prefix database run start",
    "db:stop": "npm --prefix database run stop",
    "db:status": "npm --prefix database run status",
    "db:generate": "npm --prefix database run generate",
    "db:migrate:status": "npm --prefix database run migrate:status",
    "db:migrate:deploy": "npm --prefix database run migrate:deploy",
    "db:migrate:dev": "npm --prefix database run migrate:dev",
    "db:seed": "npm --prefix database run seed",
    "db:verify": "npm --prefix database run verify",
    "admin:bootstrap": "npm --prefix backend run admin:bootstrap",
    "admin:recover": "npm --prefix backend run admin:recover --"
  }
}
